class_name TileLayer
extends RefCounted
## Lays the Racing Kit's grid road tiles (the Proving Ground) into the
## ground chunks, recoloured with the ground material so they get wet in
## the rain like generated road.


## Merges `tiles` (from ProvingGround.tiles) into the chunk meshes.
static func merge(view: TrackView, tiles: Array, meshes: Array) -> Array:
	return meshes
